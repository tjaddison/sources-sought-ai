# Sources Sought AI Environment Configuration
# Copy this file to .env and fill in your values

# Environment
ENVIRONMENT=dev

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your-account-id

# API Keys (Store these securely in AWS Secrets Manager for production)
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
SAM_GOV_API_KEY=your-sam-gov-api-key

# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your-webhook

# Email Configuration
EMAIL_USERNAME=your-email@company.com
EMAIL_PASSWORD=your-email-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# Database Configuration
DYNAMODB_TABLE_PREFIX=ss-dev

# Authentication
JWT_SECRET=your-jwt-secret-key
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Monitoring
ERROR_NOTIFICATION_EMAIL=admin@company.com
LOG_LEVEL=INFO

# Agent Configuration
SAM_GOV_SEARCH_LOOKBACK_DAYS=30
ANALYSIS_TIMEOUT_MINUTES=15
APPROVAL_TIMEOUT_HOURS=24
CONFIDENCE_THRESHOLD=0.7

# Security
KMS_KEY_ID=your-kms-key-id